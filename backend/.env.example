# ============================================================
# DocuVerify AI — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# --- Database ---
# SQLite (dev default):
DATABASE_URL=sqlite:///./docuverify.db
# PostgreSQL (production example):
# DATABASE_URL=postgresql://user:password@localhost:5432/docuverify

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- File Storage ---
# Absolute or relative path to the storage directory
STORAGE_DIR=../storage
MAX_UPLOAD_MB=20

# --- OCR ---
# Path to Tesseract binary (Windows example).
# Download from: https://github.com/UB-Mannheim/tesseract/wiki
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# --- AI Provider (optional) ---
# Leave blank to use the deterministic grounded fallback.
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Environment ---
ENVIRONMENT=development
